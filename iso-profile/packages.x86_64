ntfs-3g
exfatprogs
squashfs-tools
syslinux
edk2-shell
amd-ucode
intel-ucode
cachyos-keyring
cachyos-mirrorlist
btrfs-progs
snapper
zram-generator
networkmanager
bluez-utils
