wget
unzip
7zip
rsync
openssh
nano
vim
htop
btop
fastfetch
less
man-db
bash-completion
dmidecode
lm_sensors
lsof
pciutils
usbutils
xdg-user-dirs
xdg-utils
desktop-file-utils

